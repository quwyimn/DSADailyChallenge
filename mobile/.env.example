# Copy to .env for local dev
# EXPO_PUBLIC_* variables are bundled at build time — never put secrets here

# Development (local backend over LAN or localhost)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Production: set this when building for App Store / EAS Build
# iOS blocks plain HTTP, so this MUST be https in production
# EXPO_PUBLIC_API_URL=https://your-render-backend.onrender.com/api
