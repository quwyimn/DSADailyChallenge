# Copy to .env.development (local) or set as platform env vars (Render/production)

DATABASE_URL="postgresql://user:password@localhost:5432/dsa_daily_dev?schema=public"
JWT_SECRET="generate-with: openssl rand -base64 48"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed CORS origins (production only; ignored in dev)
CORS_ORIGINS="https://your-admin.vercel.app"
